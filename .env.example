# Copy to .env.local for local work. Never commit real values.

# --- Booking (Neon Postgres) ---
BOOKING_DATABASE_URL=            # Neon pooled connection string
BOOKING_ADMIN_PASSWORD=          # 24+ characters, opens /admin/bookings/

# --- Emails (Resend) ---
RESEND_API_KEY=
BOOKING_FROM_EMAIL=              # e.g. Webix Solutions <info@webixsolutions.com> (domain must be verified in Resend)
BOOKING_NOTIFY_EMAIL=            # where staff notices go; defaults to info@webixsolutions.com

# --- Meeting link ---
BOOKING_MEETING_URL=             # optional shared https meeting link used for every booking

# --- Reminders ---
CRON_SECRET=                     # 24+ characters; also stored as a GitHub secret for the reminder workflow

# --- Google Calendar (next phase) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Forms ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
